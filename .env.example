# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/football_ai?sslmode=require"

# Redis (Upstash)
REDIS_URL="redis://default:password@redis.upstash.io:6379"

# ========================================
# Football API Keys (Choose one or both)
# ========================================

# Option 1: Football-Data.org (Primary - Recommended)
# - 10 requests/minute (free tier)
# - 12 competitions (Premier League, La Liga, Serie A, Bundesliga, Ligue 1, etc.)
# - Register: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY="your-football-data-key"
NEXT_PUBLIC_FOOTBALL_DATA_KEY="your-football-data-key"

# Option 2: API-Football (Secondary/Fallback)
# - 100 requests/day (free tier)
# - All competitions available
# - Register: https://www.api-football.com/
API_FOOTBALL_KEY="your-api-football-key"
NEXT_PUBLIC_API_FOOTBALL_KEY="your-api-football-key"

# Google Gemini AI (for AI-powered predictions)
# Register: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash-exp"

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_EXPIRES_IN="7d"

# Next.js (Frontend)
NEXT_PUBLIC_SITE_URL="https://footballai.io"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="wss://api.footballai.io"

# ========================================
# Backend Service URLs (REQUIRED for full functionality)
# ========================================
# These must be set in Vercel for production deployment.
# Without these, auth/profile/notifications won't work and
# database fallback for match data won't be available.
#
# API Gateway URL (used by Next.js API proxy routes)
# In Vercel: Set to your Railway API Gateway URL, e.g.:
#   https://api-gateway-production-xxxx.up.railway.app
API_GATEWAY_URL="http://localhost:3000"

# User Service URL (used for auth, profile, notifications)
# In Vercel: Set to your Railway User Service URL, e.g.:
#   https://user-service-production-xxxx.up.railway.app
USER_SERVICE_URL="http://localhost:3003"

# Service URLs (for API Gateway internal routing on Railway)
MATCH_SERVICE_URL="http://localhost:3001"
STATS_SERVICE_URL="http://localhost:3002"
ML_SERVICE_URL="http://localhost:8000"

# Use mock data (set to 'true' for development without API keys)
# If no API keys are configured, mock data will be used automatically
NEXT_PUBLIC_USE_MOCK="false"

# Sentry (Optional)
SENTRY_DSN=""

# CORS (Frontend URL for backend services)
FRONTEND_URL="https://footballai.io"

# Node Environment
NODE_ENV="development"

# Vercel (auto-set by Vercel)
# VERCEL_URL=""
