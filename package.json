{
  "name": "football-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered football match predictions",
  "author": "Yuksel Arslan",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:services": "turbo run dev --filter=api-gateway --filter=match-service --filter=stats-service --filter=user-service",
    "dev:ml": "cd services/ml-service && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:full": "concurrently -n web,svc,ml -c blue,green,yellow \"pnpm dev:web\" \"pnpm dev:services\" \"pnpm dev:ml\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @football-ai/database db:generate",
    "db:push": "pnpm --filter @football-ai/database db:push",
    "db:migrate": "pnpm --filter @football-ai/database db:migrate",
    "db:studio": "pnpm --filter @football-ai/database db:studio",
    "db:seed": "pnpm --filter @football-ai/database db:seed",
    "setup": "bash scripts/setup.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "concurrently": "^9.1.2",
    "prettier": "^3.2.5",
    "turbo": "^2.3.3",
    "typescript": "^5.3.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "type": "module"
}
