# FootballAI Web App Environment Variables
# Copy to .env.local and fill in values

# DATA SOURCE: proxy (default) or gateway
NEXT_PUBLIC_DATA_SOURCE=proxy
NEXT_PUBLIC_API_URL=http://localhost:3000

# Football-Data.org API key (free: 10 req/min)
FOOTBALL_DATA_KEY=
# API-Football: use ONE of these (RapidAPI recommended)
API_FOOTBALL_KEY=
RAPIDAPI_KEY=

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI Predictions — at least one provider key required
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ML_SERVICE_URL=http://localhost:8000

# Task-based model routing overrides (optional; defaults auto-select the
# best configured model per task: research/analysis/prediction)
# AI_MODEL_RESEARCH=
# AI_MODEL_ANALYSIS=
# AI_MODEL_PREDICTION=

# Auth
JWT_SECRET=your-secret-min-32-chars-long-here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebSocket live scores
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Feature flags
NEXT_PUBLIC_ENABLE_WS=true
NEXT_PUBLIC_ENABLE_PREDICTIONS=true
NEXT_PUBLIC_ENABLE_AUTH=true

# App
NEXT_PUBLIC_SITE_URL=https://footballai.io

# ============================================
# Whop credit purchases (POST /api/webhooks/whop)
# ============================================
# Webhook signing secret (Whop dashboard -> Developers -> Webhooks).
# Required — webhook posts are rejected when this is unset.
WHOP_WEBHOOK_SECRET=

# Plan IDs from the Whop dashboard, one per credit package. Used by the
# webhook to map a paid product back to a credit grant. If unset, the
# handler falls back to USD-amount matching (50/100/270 -> 100/210/650 cr).
WHOP_PLAN_STARTER_ID=
WHOP_PLAN_STANDARD_ID=
WHOP_PLAN_PRO_ID=

# Checkout URLs surfaced on /pricing. Without these the package buttons
# render as "Coming soon" placeholders.
NEXT_PUBLIC_WHOP_PACKAGE_STARTER=
NEXT_PUBLIC_WHOP_PACKAGE_STANDARD=
NEXT_PUBLIC_WHOP_PACKAGE_PRO=
