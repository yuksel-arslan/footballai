# ============================================
# ML Service — Environment Variables
# ============================================

# Server
PORT=8000

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/football_ai?sslmode=require"

# Redis (Upstash)
REDIS_URL="redis://default:password@redis.upstash.io:6379"

# Football-Data.org (for data collection)
FOOTBALL_DATA_KEY=your-football-data-key

# Model Config
MODEL_PATH=trained_models/model_v1.joblib
MODEL_VERSION=v1.0.0
