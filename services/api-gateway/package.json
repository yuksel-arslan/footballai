{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway - central entry point, routing, rate limiting",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "http-proxy-middleware": "^3.0.3",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@football-ai/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
