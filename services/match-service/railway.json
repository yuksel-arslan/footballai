{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "installCommand": "corepack enable && pnpm install --frozen-lockfile",
    "buildCommand": "pnpm --filter @football-ai/database db:generate && pnpm --filter @football-ai/database build && pnpm --filter match-service build"
  },
  "deploy": {
    "startCommand": "pnpm --filter match-service start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
