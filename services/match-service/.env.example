# ============================================
# Match Service — Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=3001

# Database (Neon PostgreSQL) — REQUIRED
DATABASE_URL="postgresql://user:password@host.neon.tech/football_ai?sslmode=require"

# Redis (Upstash)
REDIS_URL="redis://default:password@redis.upstash.io:6379"

# Football-Data.org (Primary API — 10 req/min free tier)
# Register: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your-football-data-key

# API-Football (Fallback — 100 req/day free tier)
# Register: https://www.api-football.com/
API_FOOTBALL_KEY=your-api-football-key

# JWT — REQUIRED (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Google Gemini AI (for AI predictions)
# Register: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp
